<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sale_detail"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clients"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSaleClient"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_client_selected"
            android:textSize="18sp"
            android:padding="14dp"
            android:background="#E0ECFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/products"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSaleProduct"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_product_selected"
            android:textSize="18sp"
            android:padding="14dp"
            android:background="#F0E5FF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sale_type"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSaleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/pending"
            android:padding="14dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvSaleTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/total_amount"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="#DFF7E7"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvSaleFirstPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/first_payment"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#FFF1DB"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvSaleBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remaining_balance"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#FFE5E5"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/delivery_date"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSaleDeliveryDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_date"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_due_date"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSaleDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_date"
            android:padding="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_receipt"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/ivPaymentReceipt"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="@string/payment_receipt"
            android:background="#E6EDF7"
            android:scaleType="centerInside"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_status"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/pbPaymentProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="12dp"
            android:max="100"
            android:progress="0"
            android:layout_marginBottom="18dp" />

        <Button
            android:id="@+id/btnRegisterPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_payment" />

        <Button
            android:id="@+id/btnViewLocation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/view_location" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notes"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvSaleNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/no_notes"
            android:padding="14dp"
            android:background="#FFF1DB" />

    </LinearLayout>
</ScrollView>
