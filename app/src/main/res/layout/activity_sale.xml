<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/new_sale"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/clients"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spClient"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/select_client"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/products"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spProduct"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/select_product"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etQuantity"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/quantity"
            android:inputType="number"
            android:minHeight="48dp"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/sale_type"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgSaleType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbRetail"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/retail"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbWholesale"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/wholesale"
                android:layout_marginStart="20dp" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_method"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgPaymentType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbCashPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cash_payment"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbCreditPayment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/credit_payment"
                android:layout_marginStart="20dp" />

        </RadioGroup>

        <EditText
            android:id="@+id/etUnitPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/unit_price"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:id="@+id/tvTotalAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/total_amount"
            android:textSize="18sp"
            android:textStyle="bold"
            android:padding="16dp"
            android:background="#E0ECFF"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvFirstPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/first_payment"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#DFF7E7"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvRemainingBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remaining_balance"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#FFE5E5"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_due_date"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnSelectDueDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_date"
            android:layout_marginBottom="16dp" />

        <CheckBox
            android:id="@+id/cbProductDelivered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/product_delivered"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnSaveSale"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_sale" />

    </LinearLayout>
</ScrollView>
