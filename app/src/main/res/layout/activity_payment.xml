<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F8FAFC">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/register_payment"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="#172033"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_sale"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/spPaymentSale"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/select_sale"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/total_amount"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPaymentSaleTotal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/amount_not_available"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#E0ECFF"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/remaining_balance"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPaymentBalance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/amount_not_available"
            android:textSize="18sp"
            android:padding="16dp"
            android:background="#FFE5E5"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_amount"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPaymentAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/payment_amount"
            android:inputType="numberDecimal"
            android:minHeight="48dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_method"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/rgPaymentMethod"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rbCash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cash"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbBankTransfer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bank_transfer" />

        </RadioGroup>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_date"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btnPaymentDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/select_date"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/payment_receipt"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <ImageView
            android:id="@+id/ivPaymentReceipt"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="@string/payment_receipt"
            android:scaleType="centerInside"
            android:background="#E6EDF7"
            android:layout_marginBottom="10dp" />

        <Button
            android:id="@+id/btnAddReceipt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/add_receipt"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notes"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etPaymentNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/payment_notes_hint"
            android:inputType="textMultiLine"
            android:gravity="top"
            android:minLines="3"
            android:layout_marginBottom="20dp" />

        <Button
            android:id="@+id/btnSavePayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/save_payment" />

        <Button
            android:id="@+id/btnCancelPayment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cancel" />

    </LinearLayout>
</ScrollView>
